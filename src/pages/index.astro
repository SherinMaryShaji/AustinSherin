---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  {/* Global Noise Overlay */}
  <div
    class="fixed inset-0 w-full h-full opacity-[0.03] pointer-events-none z-0"
    style="background-image: url('https://cdn.prod.website-files.com/6a04a1cfb75e6726e196798d/6a04a1d6b75e6726e1967adf_ZTrl.gif'); background-size: 200px;"
  >
  </div>

  {/* Floating dates - Positioned outside the card */}
  <div
    class="fixed top-3 left-3 md:top-8 md:left-8 z-50 text-white font-molika text-lg md:text-3xl font-bold opacity-70 pointer-events-none"
  >
    20
  </div>
  <div
    class="fixed top-3 right-3 md:top-8 md:right-8 z-50 text-white font-molika text-lg md:text-3xl font-bold opacity-70 pointer-events-none"
  >
    26
  </div>
  <div
    class="fixed bottom-3 left-3 md:bottom-8 md:left-8 z-50 text-white font-molika text-lg md:text-3xl font-bold opacity-70 pointer-events-none"
  >
    07
  </div>
  <div
    class="fixed bottom-3 right-3 md:bottom-8 md:right-8 z-50 text-white font-molika text-lg md:text-3xl font-bold opacity-70 pointer-events-none"
  >
    20
  </div>

  {/* Pin Container for Sticky Scroll */}
  <div class="relative h-[450vh] mt-4 md:mt-8 mb-12 md:mb-16" id="pinContainer">
    {/* Pinned Blue Card */}
    <section
      class="sticky top-4 md:top-8 w-[calc(100%-1.5rem)] md:w-[calc(100%-8rem)] mx-auto h-[80vh] md:h-[85vh] rounded-3xl md:rounded-[2.5rem] bg-[#2D8CDB] z-10 shadow-2xl overflow-hidden"
      id="blueCard"
    >
      {/* Fixed Background Sky within card */}
      <div
        class="sticky top-0 w-full h-[80vh] md:h-[85vh] z-0 pointer-events-none"
      >
        <img
          src="https://cdn.prod.website-files.com/6a04a1cfb75e6726e196798d/6a04a1d6b75e6726e1967af5_blue%20sky%20gb.jpg"
          alt="Blue Sky"
          class="w-full h-full object-cover object-bottom"
        />
      </div>

      {/* Parallax Clouds */}
      <div
        class="sticky top-0 w-full h-[80vh] md:h-[85vh] z-0 pointer-events-none -mt-[80vh] md:-mt-[85vh] overflow-hidden"
      >
        {/* Pair 1 */}
        <img
          src="https://cdn.prod.website-files.com/6a04a1cfb75e6726e196798d/6a04a1d6b75e6726e1967aea_cloud%20web1.png"
          alt="Cloud"
          class="parallax-cloud-fast absolute top-[30%] -left-12 md:-left-24 w-[60%] max-w-[600px] h-auto object-contain transform translate-y-0 opacity-90 mix-blend-screen"
        />
        <img
          src="https://cdn.prod.website-files.com/6a04a1cfb75e6726e196798d/6a04a1d6b75e6726e1967aed_cloud%20web3.png"
          alt="Cloud"
          class="parallax-cloud-slow absolute top-[10%] -right-12 md:-right-24 w-[50%] max-w-[500px] h-auto object-contain transform translate-y-0 opacity-90 mix-blend-screen"
        />

        {/* Pair 2 */}
        <img
          src="https://cdn.prod.website-files.com/6a04a1cfb75e6726e196798d/6a04a1d6b75e6726e1967aed_cloud%20web3.png"
          alt="Cloud"
          class="parallax-cloud-slow absolute top-[120%] -left-16 md:-left-32 w-[55%] max-w-[550px] h-auto object-contain transform translate-y-0 opacity-80 mix-blend-screen"
        />
        <img
          src="https://cdn.prod.website-files.com/6a04a1cfb75e6726e196798d/6a04a1d6b75e6726e1967aea_cloud%20web1.png"
          alt="Cloud"
          class="parallax-cloud-fast absolute top-[90%] -right-8 md:-right-16 w-[65%] max-w-[650px] h-auto object-contain transform translate-y-0 opacity-85 mix-blend-screen"
        />

        {/* Pair 3 */}
        <img
          src="https://cdn.prod.website-files.com/6a04a1cfb75e6726e196798d/6a04a1d6b75e6726e1967aea_cloud%20web1.png"
          alt="Cloud"
          class="parallax-cloud-fast absolute top-[210%] -left-10 md:-left-20 w-[60%] max-w-[600px] h-auto object-contain transform translate-y-0 opacity-90 mix-blend-screen"
        />
        <img
          src="https://cdn.prod.website-files.com/6a04a1cfb75e6726e196798d/6a04a1d6b75e6726e1967aed_cloud%20web3.png"
