  <style>
    .parallax-content {
      will-change: transform;
    }
    .parallax-polaroid {
      will-change: transform;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4);
      transition: box-shadow 0.3s ease;
    }
    #contentContainer {
      will-change: transform;
    }
    #darkSection {
      will-change: transform;
    }
  </style>

  <script>
    // Elements
    const blueCard = document.getElementById("blueCard");
    const pinContainer = document.getElementById("pinContainer");
    const contentContainer = document.getElementById("contentContainer");
    const darkSection = document.getElementById("darkSection");
    const polaroidsContainer = document.getElementById("polaroidsContainer");
    const cloudsFast = document.querySelectorAll(".parallax-cloud-fast");
    const cloudsSlow = document.querySelectorAll(".parallax-cloud-slow");
    const parallaxElements = document.querySelectorAll(".parallax-content");

    // Hover detection for polaroids
    const polaroids = document.querySelectorAll(".parallax-polaroid");
    polaroids.forEach((el) => {
      el.addEventListener("mouseenter", () => {
        el.setAttribute("data-hovered", "true");
      });
      el.addEventListener("mouseleave", () => {
        el.removeAttribute("data-hovered");
      });
    });

    if (blueCard && pinContainer && contentContainer && polaroidsContainer) {
      // Animation state variables
      let currentScroll = 0;
      let targetScroll = 0;

      let mouseX = 0;
      let mouseY = 0;
      let targetMouseX = 0;
      let targetMouseY = 0;

      // Track mouse relative to blueCard
      blueCard.addEventListener("mousemove", (e) => {
        const rect = blueCard.getBoundingClientRect();
        targetMouseX = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        targetMouseY = ((e.clientY - rect.top) / rect.height) * 2 - 1;

        // Spawn stardust particles sometimes
        if (Math.random() < 0.25) {
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          createStardust(x, y);
        }
      });

      blueCard.addEventListener("mouseleave", () => {
        targetMouseX = 0;
        targetMouseY = 0;
      });

      // Particle System
      const particles = [];

      function createStardust(x, y) {
        const particle = document.createElement("div");
        particle.className =
          "absolute pointer-events-none z-30 transition-opacity duration-300";

        const isSparkle = Math.random() > 0.4;
        const size = Math.random() * 14 + 6;

        particle.style.width = `${size}px`;
        particle.style.height = `${size}px`;
        particle.style.left = `${x}px`;
        particle.style.top = `${y}px`;
        particle.style.transform = "translate(-50%, -50%)";

        if (isSparkle) {
          particle.innerHTML = `
          <svg viewBox="0 0 24 24" fill="none" class="text-brand-yellow w-full h-full opacity-90">
            <path d="M12 0L14.6 9.4L24 12L14.6 14.6L12 24L9.4 14.6L0 12L9.4 9.4L12 0Z" fill="currentColor"/>
          </svg>
        `;
        } else {
          particle.style.borderRadius = "50%";
          particle.style.background =
            "radial-gradient(circle, rgba(255,255,255,0.9) 0%, rgba(241,207,68,0.4) 50%, rgba(241,207,68,0) 80%)";
        }

        blueCard.appendChild(particle);

        particles.push({
          element: particle,
          x: x,
          y: y,
          vx: (Math.random() - 0.5) * 1.5,
          vy: (Math.random() - 0.5) * 1.2 - 0.8,
          alpha: 1.0,
          scale: 1.0,
          decay: 0.015 + Math.random() * 0.015,
        });
      }

      function updateParticles() {
        for (let i = particles.length - 1; i >= 0; i--) {
          const p = particles[i];
          p.x += p.vx;
          p.y += p.vy;
          p.alpha -= p.decay;
          p.scale -= p.decay * 0.5;

          if (p.alpha <= 0 || p.scale <= 0) {
            p.element.remove();
            particles.splice(i, 1);
          } else {
            p.element.style.left = `${p.x}px`;
            p.element.style.top = `${p.y}px`;
            p.element.style.opacity = p.alpha.toString();
            p.element.style.transform = `translate(-50%, -50%) scale(${p.scale})`;
          }
        }
      }

      // Main animation loop
      function animate() {
        const pinTop = pinContainer.offsetTop;
        const pinHeight = pinContainer.offsetHeight;
        const cardHeight = blueCard.offsetHeight;
        const contentHeight = contentContainer.offsetHeight;
        const viewportHeight = window.innerHeight;

        const stickyOffset = window.innerWidth >= 768 ? 32 : 16;
        const startScroll = pinTop - stickyOffset;
        const endScroll = pinTop + pinHeight - cardHeight - stickyOffset;

        const maxScroll = Math.max(0, contentHeight - cardHeight);

        let progress = 0;
        if (endScroll - startScroll > 0) {
          progress = (window.scrollY - startScroll) / (endScroll - startScroll);
          progress = Math.max(0, Math.min(1, progress));
        }

        targetScroll = progress * maxScroll;

        currentScroll += (targetScroll - currentScroll) * 0.08;
        mouseX += (targetMouseX - mouseX) * 0.06;
        mouseY += (targetMouseY - mouseY) * 0.06;

        contentContainer.style.transform = `translateY(${-currentScroll}px)`;

        if (darkSection) {
          let darkTranslateY = 0;
          if (window.scrollY > pinTop + pinHeight - viewportHeight) {
            if (window.scrollY < endScroll) {
              darkTranslateY =
                window.scrollY + viewportHeight - (pinTop + pinHeight);
            } else {
              darkTranslateY =
                endScroll + viewportHeight - (pinTop + pinHeight);
            }
          }
          darkSection.style.transform = `translateY(${darkTranslateY}px)`;
        }

        cloudsFast.forEach((cloud) => {
          cloud.style.transform = `translateY(${currentScroll * -0.4}px)`;
        });
        cloudsSlow.forEach((cloud) => {
          cloud.style.transform = `translateY(${currentScroll * -0.2}px)`;
        });

        // Update parallax elements
        parallaxElements.forEach((el) => {
          const speed = parseFloat(
            el.getAttribute("data-parallax-speed") || "0",
          );
          const mouseSpeed = parseFloat(
            el.getAttribute("data-mouse-speed") || "15",
          );

          const scrollYOffset = currentScroll * speed;
          const mouseXOffset = mouseX * mouseSpeed;
          const mouseYOffset = mouseY * mouseSpeed;

          if (el.classList.contains("parallax-polaroid")) {
            const baseRotate = parseFloat(
              el.getAttribute("data-base-rotate") || "0",
            );
            const baseTx = parseFloat(el.getAttribute("data-base-tx") || "0");

            const isHovered = el.getAttribute("data-hovered") === "true";

            // Hover transitions
            const targetHoverScale = isHovered ? 1.05 : 1.0;
            const targetHoverRotate = isHovered ? 0 : baseRotate;

            let curHoverScale = parseFloat(
              el.getAttribute("data-current-hover-scale") || "1.0",
            );
            let curHoverRotate = parseFloat(
              el.getAttribute("data-current-hover-rotate") ||
                baseRotate.toString(),
            );

            curHoverScale += (targetHoverScale - curHoverScale) * 0.12;
            curHoverRotate += (targetHoverRotate - curHoverRotate) * 0.12;

            el.setAttribute(
              "data-current-hover-scale",
              curHoverScale.toString(),
            );
            el.setAttribute(
              "data-current-hover-rotate",
              curHoverRotate.toString(),
            );

            // 3D Tilt parameters
            const tiltX = mouseY * -5;
            const tiltY = mouseX * 5;

            // Combine vertical timeline offset + responsive tilt effects
            el.style.transform = `translateX(${baseTx + mouseXOffset}px) translateY(${mouseYOffset}px) scale(${curHoverScale}) rotate(${curHoverRotate + mouseX * 1.5}deg) perspective(1000px) rotateX(${tiltX}deg) rotateY(${tiltY}deg)`;
          } else {
            el.style.transform = `translateY(${scrollYOffset}px) translate(${mouseXOffset}px, ${mouseYOffset}px)`;
          }
        });

        updateParticles();
        requestAnimationFrame(animate);
      }

      animate();
    }
  </script>
</Layout>
